# Answers for unattended installation: ./install.sh --answers FILE --yes
#
# KEY = value, one per line. Lines starting with # are ignored. Anything left out uses the default shown.
# NEVER put a password here (the installer refuses keys containing PASS, SECRET or TOKEN).
# The user sets the password themselves with: ./install.sh --set-password

# Keep an existing ~/.config/cctv-overlay/config.ini (no) or replace it after a backup (yes).
OVERWRITE_CONFIG = no

# Install missing Arch packages with sudo pacman (needs the user at a terminal for sudo).
INSTALL_DEPS = no

# dahua | hikvision | reolink | uniview | standalone | custom
SYSTEM = dahua
# Recorder address and RTSP port (not used for standalone).
HOST = 192.168.1.100
PORT = 554
# Only for SYSTEM = custom. Placeholders: {channel} {channel02} {subtype} {stream} {mainsub}
# PATH_TEMPLATE = /live/ch{channel}/{mainsub}
USERNAME = viewer
# main | sub
STREAM = main

CAMERAS = 4
CAMERA_1_NAME = Front Door
CAMERA_1_CHANNEL = 1
CAMERA_2_NAME = Driveway
CAMERA_2_CHANNEL = 2
CAMERA_3_NAME = Backyard
CAMERA_3_CHANNEL = 3
CAMERA_4_NAME = Garage
CAMERA_4_CHANNEL = 4
# For SYSTEM = standalone use, per camera, instead of CHANNEL:
# CAMERA_1_HOST = 192.168.1.21
# CAMERA_1_BRAND = dahua | hikvision | reolink | tapo | uniview | custom
# CAMERA_1_PATH = /stream1          (only for BRAND = custom)

# Connector name from `hyprctl monitors` (e.g. DP-1, HDMI-A-1) or focused.
MONITOR = DP-1
# 480x270 | 600x338 | 720x405 | 960x540
SIZE = 720x405
# top-right | top-left | bottom-right | bottom-left
ANCHOR = top-right

# Hyprland keys: MODIFIERS + KEY. none = do not bind.
BIND_TOGGLE = CTRL + KP_Multiply
BIND_NEXT = KP_Multiply
BIND_PREV = KP_Divide
BIND_AUDIO = CTRL + KP_Subtract

# Open the overlay once at the end to test the cameras (only happens when a password is already set).
RUN_TEST = yes
